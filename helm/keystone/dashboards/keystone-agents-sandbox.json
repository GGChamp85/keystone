{
  "title": "Keystone Agents — Sandbox & Task Health",
  "uid": "keystone-agents-sandbox",
  "tags": ["keystone", "agents", "sandbox"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Sandbox executions by backend/status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (backend, status) (rate(keystone_sandbox_executions_total[5m]))",
          "legendFormat": "{{backend}} / {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Sandbox failure rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(keystone_sandbox_executions_total{status=~\"error|timeout\"}[5m])) / sum(rate(keystone_sandbox_executions_total[5m]))",
          "legendFormat": "failure rate",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Agent task duration (p50/p95) by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, status) (rate(keystone_agent_task_duration_seconds_bucket[15m])))",
          "legendFormat": "p50 {{status}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, status) (rate(keystone_agent_task_duration_seconds_bucket[15m])))",
          "legendFormat": "p95 {{status}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Circuit breaker trips by reason",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (reason) (increase(keystone_circuit_breaker_trips_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Sandbox daemon process (self-scrape)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"keystone-sandbox-daemon\"}",
          "legendFormat": "RSS bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Tasks completed (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(keystone_agent_task_duration_seconds_count{status=\"completed\"}[24h]))", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Tasks failed (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(keystone_agent_task_duration_seconds_count{status=\"failed\"}[24h]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    }
  ]
}
