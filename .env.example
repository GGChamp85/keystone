# ============================================================
# Keystone — Keystone Inference & Keystone Agents
# Production Environment Configuration
# ============================================================

# ---------- Platform ----------
VS_ENV=production
VS_DEBUG=false
VS_SECRET_KEY=generate-a-64-char-hex-with-openssl-rand-hex-32
VS_ADMIN_EMAIL=admin@keystone.local
VS_PLATFORM_NAME=Keystone
CORS_ALLOWED_ORIGINS=["https://keystone.local"]

# ---------- Root Admin (bootstraps tenants/API keys — see keys.py) ----------
KEYSTONE_ROOT_ADMIN_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=keystone
POSTGRES_USER=keystone
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
DATABASE_URL=postgresql+asyncpg://keystone:CHANGE_ME_STRONG_PG_PASSWORD@postgres:5432/keystone

# ---------- Redis ----------
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------- Keystone Inference — model endpoints ----------
# Defaults below match docker-compose.yml's vllm-* services; point any of
# these at something else instead — your own vLLM elsewhere, or (no GPU at
# all) benchmarks/frontier_proxy.py for a real frontier model. From inside
# this container that's http://host.docker.internal:8090/v1 on Docker
# Desktop (Mac/Windows); on Linux add `extra_hosts: ["host.docker.internal:host-gateway"]`
# to the service in docker-compose.yml, or use the host's real LAN/bridge IP.
VLLM_CODING_URL=http://vllm-coding:8000/v1
VLLM_CODING_FALLBACK_URL=http://vllm-coding-fallback:8000/v1
VLLM_REASONING_URL=http://vllm-reasoning:8000/v1

# Optional per-role bearer token for hosted OpenAI-compatible endpoints (a
# self-hosted in-cluster vLLM needs none). Sent as "Authorization: Bearer ...".
VLLM_CODING_API_KEY=
VLLM_CODING_FALLBACK_API_KEY=
VLLM_REASONING_API_KEY=

# RunPod Serverless (docs/deployment/RUNPOD_SETUP.md). One key authenticates
# the endpoint's OpenAI-compatible base URL and RunPod's management API.
# To serve a role from it: VLLM_CODING_URL=https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
# and VLLM_CODING_API_KEY=<the same RunPod key>. `keystone doctor` checks both.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_URL=

# Model identifiers served by each vLLM instance (src/config.py) — irrelevant
# when pointed at benchmarks/frontier_proxy.py, which ignores this and always
# serves whatever FRONTIER_PROXY_MODEL it was started with.
CODING_MODEL_ID=zai-org/GLM-5.3-Flash
CODING_FALLBACK_MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct
REASONING_MODEL_ID=deepseek-ai/DeepSeek-R1

# ---------- Qdrant Vector DB ----------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=CHANGE_ME_QDRANT_KEY
QDRANT_COLLECTION=keystone_code_memory

# ---------- Embedding ----------
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# ---------- Sandbox (self-hosted Firecracker/gVisor daemon — see src/sandbox/) ----------
SANDBOX_BACKEND=gvisor
SANDBOX_DAEMON_URL=http://sandbox-daemon:9000
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_CONCURRENT=10

# ---------- Token Budgets & Limits ----------
DEFAULT_DAILY_TOKEN_LIMIT=5000000
DEFAULT_MONTHLY_TOKEN_LIMIT=100000000
MAX_AGENT_ITERATIONS=15
MAX_TOKENS_PER_REQUEST=32768

# ---------- Temporal — Durable Execution ----------
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=keystone
TEMPORAL_TASK_QUEUE=keystone-agent-tasks

# ---------- Observability ----------
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- Git server — required for any agentic coding task, not just air-gapped ----------
# A JSON array, not a bare string (this project's other list-typed settings,
# e.g. CORS_ALLOWED_ORIGINS above, follow the same format) — a plain
# comma-separated value here fails Keystone's startup outright, not just a
# silently-wrong default. Point this at your own git server (see the
# README's "Connect your own git server") or a Gitea instance you run
# yourself; Keystone never invents a repository to work in.
GIT_ALLOWED_HOSTS=["gitea.internal.keystone.local"]
GIT_HOST_API_URL=http://gitea.internal.keystone.local:3000/api/v1
GIT_HOST_TOKEN=
GITEA_WEBHOOK_SECRET=

# ---------- Fine-Tuning ----------
WANDB_API_KEY=
WANDB_MODE=disabled
FINETUNING_OUTPUT_DIR=/data/finetuning/output
FINETUNING_DATA_DIR=/data/finetuning/data
HF_TOKEN=
HF_HUB_OFFLINE=0
