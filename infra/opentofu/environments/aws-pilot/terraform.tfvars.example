# Copy to terraform.tfvars (git-ignored) and edit. Every value has a default
# in variables.tf; only override what you need.

aws_region   = "us-east-1"
cluster_name = "keystone-pilot"

# One NVIDIA L4 (24 GB) per node. g6.2xlarge = 8 vCPU / 32 GiB host RAM.
gpu_instance_type = "g6.2xlarge"
gpu_node_count    = 1
gpu_node_min      = 0
gpu_node_max      = 2

system_instance_type = "m6i.xlarge"
system_node_count    = 2

tags = {
  Project     = "keystone"
  Environment = "pilot"
  Owner       = "you@example.com"
}
