# Secrets / environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.venv-train/
venv/

# TLS certs (generated by `make certs` / `make certs-ca`)
nginx/certs/*.pem
nginx/certs/*.key
pki/ca/
pki/certs/
pki/test-ca/
pki/test-certs/
docker/sandbox-runtimes/ca-certs/*.crt
docker/sandbox-runtimes/ca-certs/*.pem

# Data / model caches
data/
model-cache/
*.db

# IaC state
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Air-gap bundle build output
airgap/output/
airgap/wheelhouse/
airgap/models/

# OpenBao dev/test bootstrap state (unseal key + root token — never commit)
openbao/.openbao-init.json

# OS cruft
.DS_Store

# Build artifacts
dist/
build/
.claude/
site/
